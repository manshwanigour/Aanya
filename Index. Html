<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Happy Birthday Anu Darling 💗</title>
<style>
*{box-sizing:border-box}
body{
  margin:0; min-height:100vh; font-family:Georgia, 'Times New Roman', serif;
  background:linear-gradient(135deg,#fff7fb,#ffe8f2 45%,#fff);
  color:#63364a; overflow-x:hidden;
}
.wrap{max-width:760px;margin:auto;padding:22px 16px 50px}
.card{
  background:rgba(255,255,255,.9); border:1px solid #f6cddd; border-radius:30px;
  box-shadow:0 18px 55px rgba(148,65,105,.15); overflow:hidden; position:relative;
}
.hero{padding:42px 24px 26px;text-align:center;background:radial-gradient(circle at 50% 0,#ffd8e8,transparent 48%)}
.kicker{font:600 13px Arial,sans-serif;letter-spacing:3px;text-transform:uppercase;color:#b05b7d}
h1{font-size:clamp(38px,10vw,72px);margin:10px 0 4px;color:#8f3f61}
.sub{font-size:20px;margin:0;color:#8d6072}
.heart{font-size:34px;animation:pulse 1.7s infinite}
@keyframes pulse{50%{transform:scale(1.18)}}
.photos{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:14px}
.photo{width:100%;aspect-ratio:1/1;object-fit:cover;border-radius:20px;box-shadow:0 7px 20px rgba(0,0,0,.12)}
.message{padding:10px 26px 22px;text-align:center;font-size:19px;line-height:1.7}
.message strong{color:#9a3f65}
.buttons{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:0 20px 22px}
button,.song{
  border:0;border-radius:18px;padding:16px 12px;background:#fff0f6;color:#873c5d;
  font:600 15px Arial,sans-serif;cursor:pointer;box-shadow:0 6px 16px rgba(120,50,85,.10);
}
button:hover,.song:hover{transform:translateY(-2px)}
.reveal{display:none;margin:0 20px 18px;padding:18px;border-radius:18px;background:#fff8fb;text-align:center;line-height:1.6}
.reveal.show{display:block;animation:pop .35s ease}
@keyframes pop{from{opacity:0;transform:scale(.92)}to{opacity:1;transform:scale(1)}}
.song{display:block;text-decoration:none;text-align:center;margin:0 20px 24px;background:#8f3f61;color:white}
.footer{text-align:center;padding:0 20px 28px;font:13px Arial,sans-serif;color:#a06d82}
.floating{position:fixed;left:0;right:0;top:0;pointer-events:none;overflow:hidden;height:100vh}
.float-heart{position:absolute;bottom:-30px;font-size:22px;animation:float 6s linear forwards;opacity:.7}
@keyframes float{to{transform:translateY(-110vh) rotate(25deg);opacity:0}}
@media(max-width:520px){.buttons{grid-template-columns:1fr}}
</style>
</head>
<body>
<div class="floating" id="floating"></div>
<div class="wrap">
  <main class="card">
    <section class="hero">
      <div class="heart">💗</div>
      <div class="kicker">A little surprise for you</div>
      <h1>Happy Birthday<br>Anu Darling!</h1>
      <p class="sub">✨ My favourite person to make memories with ✨</p>
    </section>

    <section class="photos">
      <img class="photo" src="data:image/jpeg;base64," alt="Memory 1">
      <img class="photo" src="data:image/jpeg;base64," alt="Memory 2">
      <img class="photo" src="data:image/jpeg;base64," alt="Memory 3">
      <img class="photo" src="data:image/jpeg;base64," alt="Memory 4">
    </section>

    <section class="message">
      <p><strong>Happy birthday Anu darling! 💕</strong></p>
      <p>Thank you so much for coming in my life and making it wonderful. I miss you alot, and you are the <strong>besstttt!</strong> 🥹💗</p>
      <p><strong>I love you. 🫶🏻</strong></p>
    </section>

    <div class="buttons">
      <button onclick="reveal('r1')">🎁 Open your surprise</button>
      <button onclick="reveal('r2')">💌 A tiny letter</button>
      <button onclick="reveal('r3')">📸 Our memories</button>
      <button onclick="confetti(); reveal('r4')">🎂 Make a birthday wish</button>
    </div>

    <div id="r1" class="reveal">🎀 Surprise! You are officially stuck with me for many more memories, laughs and random moments. 💗</div>
    <div id="r2" class="reveal">Dear Anu, I hope this year brings you lots of happiness, peaceful days and reasons to smile. Never forget how special you are to me. 🌷</div>
    <div id="r3" class="reveal">Every picture has a different memory, but somehow every memory becomes better because you're in it. 🥹✨</div>
    <div id="r4" class="reveal">Close your eyes, make your wish, and tap the heart above! 💖 May your birthday wish come true.</div>

    <a class="song" href="https://www.youtube.com/watch?v=EatzcaVJRMs" target="_blank" rel="noopener">
      🎵 Play our Bollywood friendship song — Tera Yaar Hoon Main
    </a>
    <div class="footer">Made with lots of love, hearts &amp; memories 💗</div>
  </main>
</div>

<script>
function reveal(id){
  document.querySelectorAll('.reveal').forEach(x=>x.classList.remove('show'));
  document.getElementById(id).classList.add('show');
  document.getElementById(id).scrollIntoView({behavior:'smooth',block:'center'});
}
function heart(){
  const h=document.createElement('div');
  h.className='float-heart';
  h.textContent=['💗','💕','💖','🎀','✨'][Math.floor(Math.random()*5)];
  h.style.left=Math.random()*100+'vw';
  h.style.animationDuration=(4+Math.random()*4)+'s';
  document.getElementById('floating').appendChild(h);
  setTimeout(()=>h.remove(),8000);
}
setInterval(heart,650);
function confetti(){
  for(let i=0;i<30;i++) setTimeout(heart,i*45);
}
</script>
</body>
</html>
